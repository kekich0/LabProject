{
    "rewrites": [
      {
        "source": "/ingest/:path*",
        "destination": "https://us.i.posthog.com/:path*"
      }
    ],
    "headers": [
      {
        "source": "/ingest/:path*",
        "headers": [
          { "key": "Access-Control-Allow-Origin", "value": "*" },
          { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" }
        ]
      }
    ]
  }